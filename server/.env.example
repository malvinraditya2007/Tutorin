# ==============================================================
# TUTORIN - ENV CONFIGURATION
# ==============================================================

# Database MySQL (Pilih salah satu)
# Opsi 1: Cloud MySQL (TiDB Cloud / Railway / Aiven)
DATABASE_URL="mysql://<user>:<password>@<host>:<port>/<dbname>?ssl=true"

# Opsi 2: MySQL Lokal (XAMPP)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=tutorin_db
# DB_SSL=false

# Autentikasi JWT (Ganti dengan string rahasia acak)
AUTH_SECRET="your-very-strong-secret-key-change-me"

# Port Server & URL Frontend
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
